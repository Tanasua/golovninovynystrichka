# Telegram-бот, отримати токен у @BotFather
TELEGRAM_BOT_TOKEN=
# id чату/каналу, куди бот надсилає повідомлення (можна дізнатись через @userinfobot або getUpdates)
TELEGRAM_CHAT_ID=

# Ключ OpenAI API
OPENAI_API_KEY=
# Модель для звірки заголовків. Перевірте актуальну назву на
# https://platform.openai.com/docs/models — станом на момент написання
# підтверджено існування gpt-5-mini.
OPENAI_MODEL=gpt-5-mini

# Інтервал перевірки у хвилинах
CHECK_INTERVAL_MINUTES=30

# Файл, у якому бот зберігає стан (щоб не дублювати сповіщення)
STATE_FILE=state.json
